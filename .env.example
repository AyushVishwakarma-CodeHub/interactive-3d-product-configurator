# Vertical 3D Tech — Interactive Canopy Tent Configurator
# Environment Configuration Template

# Application Branding
VITE_APP_TITLE="Vertical 3D Tech — Interactive Canopy Tent Configurator"

# Shopify Storefront Integration (Mock or Live Store)
# In production, replace with your Shopify store domain and Storefront API Access Token:
VITE_SHOPIFY_STORE_DOMAIN="demo-canopy-store.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN=""

# Backend Dynamic Pricing Service (Optional External REST API)
# When omitted, the built-in asynchronous PricingService simulation is utilized:
VITE_PRICING_API_ENDPOINT=""

# Iframe & Host PostMessage Logging
VITE_ENABLE_POSTMESSAGE_LOGS="true"

